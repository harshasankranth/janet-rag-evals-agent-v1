# Selects the LLM backend: ollama | groq | gemini
LLM_PROVIDER=ollama

# Ollama is local and free (no key needed). Groq and Gemini are cloud APIs
# and need a key below if you select them via LLM_PROVIDER.
OLLAMA_MODEL=qwen3:8b

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Selects the TTS backend: piper | elevenlabs | sarvam | edge_tts
# Piper is local/free but robotic, and has no Telugu voice at all.
# ElevenLabs is very natural but Telugu needs its eleven_v3 model, and the
# free tier is small (~10k chars/month).
# Sarvam AI is purpose-built for Hindi/Telugu/English, natural, and cheaper,
# but its English voices carry an Indian accent (secondary to its Indic focus).
# Edge TTS is free, no key, no cap, genuine Azure Neural quality, and has
# real English/Hindi/Telugu voices — but it's an unofficial/reverse-engineered
# API (not a public Microsoft product), so it could in principle be
# rate-limited or broken without notice.
TTS_PROVIDER=edge_tts

# If TTS_PROVIDER fails (e.g. a cloud quota is exhausted, or edge_tts gets
# rate-limited), fall back to this provider for the rest of the session
# instead of going silent. Leave empty to disable and fail hard instead.
TTS_FALLBACK_PROVIDER=sarvam

# Voices used by TTS_PROVIDER=edge_tts, per detected language — no API key
# needed. Browse more options with `edge-tts --list-voices`.
EDGE_TTS_VOICE_EN=en-US-JennyNeural
EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural
EDGE_TTS_VOICE_TE=te-IN-ShrutiNeural

# Path to a local Piper voice model (.onnx). Download the matching <voice>.onnx
# and <voice>.onnx.json from https://huggingface.co/rhasspy/piper-voices and
# point this at the .onnx file (the .json must sit alongside it), e.g.:
# PIPER_VOICE_MODEL=models/piper/en_GB-jenny_dioco-medium.onnx
PIPER_VOICE_MODEL=

# Get a key from https://elevenlabs.io/app/settings/api-keys, and a voice ID
# by picking a voice at https://elevenlabs.io/app/voice-library (copy its
# Voice ID). Only used when TTS_PROVIDER=elevenlabs. eleven_v3 is required
# for Telugu; eleven_multilingual_v2 covers English/Hindi only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Get a key from https://dashboard.sarvam.ai. Only used when
# TTS_PROVIDER=sarvam. SARVAM_SPEAKER must be one of bulbul:v3's voices:
# aditya, ritu, ashutosh, priya, neha, rahul, pooja, rohan, simran, kavya,
# amit, dev, ishita, shreya, ratan, varun, manan, sumit, roopa, kabir,
# aayan, shubh, advait, anand, tanya, tarun, sunny, mani, gokul, vijay,
# shruti, suhani, mohit, kavitha, rehan, soham, rupali
# (a different set applies to bulbul:v2, if you switch SARVAM_MODEL back).
SARVAM_API_KEY=
SARVAM_SPEAKER=priya
SARVAM_MODEL=bulbul:v3

# Wake word ("Hey Janet"), via openWakeWord (fully local, no account needed):
# Train a custom model using the community-maintained Colab notebook at
# https://github.com/alfiedennen/openwakeword-colab-2026, download the
# resulting .onnx file, put it somewhere like models/openwakeword/, and
# point WAKE_WORD_MODEL at it, e.g.:
# WAKE_WORD_MODEL=models/openwakeword/hey_janet.onnx
WAKE_WORD_MODEL=

# Local retro HUD (orb + subtitles + waveform), opened automatically in your
# default browser. Set UI_ENABLED=false to run voice-only with no browser tab.
UI_ENABLED=true
UI_PORT=8765
